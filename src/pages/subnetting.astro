---
import Layout from '../layouts/Layout.astro';
import SubnetCalculator from '../components/SubnetCalculator.svelte';
---

<Layout title="Subnetting — Error Detection & Subnetting" description="IPv4 subnet calculator, equal-size splits, and VLSM with the general sizing rule.">
  <h1>IPv4 subnetting</h1>
  <p class="lede">
    Borrowing bits from the host portion to create subnets. How many you borrow depends on what you
    need — hosts per subnet, or number of subnets — so the general rule is stated at the bottom of
    this page rather than being buried inside one worked example.
  </p>
  <SubnetCalculator client:load />
</Layout>
