---
import '@fontsource-variable/instrument-sans';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/500.css';
import '@fontsource/martian-mono/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const groups = [
  { label: null, items: [{ n: '00', href: '/', label: 'Overview' }] },
  {
    label: 'Error detection',
    items: [
      { n: '01', href: '/crc', label: 'CRC' },
      { n: '02', href: '/circuit', label: 'Circuit' },
      { n: '03', href: '/matrix', label: 'Generator matrix' },
      { n: '04', href: '/vrc-lrc', label: 'VRC + LRC' },
      { n: '05', href: '/checksum', label: 'Checksum' },
      { n: '06', href: '/lab', label: 'Error lab' },
    ],
  },
  { label: 'Addressing', items: [{ n: '07', href: '/subnetting', label: 'Subnetting' }] },
];

// Each chapter ends by pointing at the next one, in the order the rail lists them.
const teasers: Record<string, string> = {
  '/crc': 'Polynomial division, with every step shown',
  '/circuit': 'The same division, one clock at a time',
  '/matrix': 'The same code as a matrix: derive G and H',
  '/vrc-lrc': 'Two-dimensional parity, and its rectangle blind spot',
  '/checksum': 'Sums, and the errors that cancel out',
  '/lab': 'One frame, four schemes — the error lab',
  '/subnetting': 'A different chapter: splitting an IPv4 block',
};
const order = groups.flatMap((g) => g.items);
const at = order.findIndex((item) => item.href === path);
const next = at > 0 && at < order.length - 1 ? order[at + 1] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111714" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="shell">
      <aside class="rail" id="rail">
        <div class="rail-inner">
          <div class="rail-head">
            <a class="brand" href="/">
              <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
                <rect x="1" y="1" width="12" height="12" fill="#F2F4F0"></rect>
                <rect x="15.75" y="1.75" width="10.5" height="10.5" fill="none" stroke="#F2F4F0" stroke-width="1.5"></rect>
                <rect x="1.75" y="15.75" width="10.5" height="10.5" fill="none" stroke="#F2F4F0" stroke-width="1.5"></rect>
                <rect x="15" y="15" width="12" height="12" fill="#5B6DFF"></rect>
              </svg>
              <span class="brand-text"><strong>Error detection</strong><span>&amp; subnetting</span></span>
            </a>
            <button class="rail-toggle" type="button" aria-expanded="false" aria-controls="rail-nav" aria-label="Chapters menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
              </svg>
            </button>
          </div>

          <nav class="rail-nav" id="rail-nav" aria-label="Chapters">
            {
              groups.map((group) => (
                <div class="rail-group">
                  {group.label && <div class="rail-label">{group.label}</div>}
                  {group.items.map((item) => (
                    <a class="rail-link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                      <span class="n">{item.n}</span>
                      <span>{item.label}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>

          <div class="rail-foot">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
            <span>Runs in your browser. Nothing is sent anywhere.</span>
          </div>
        </div>
      </aside>

      <main class="site" id="content">
        <div class="site-inner">
          <slot />

          {
            next && (
              <a class="next-link" href={next.href}>
                <span>
                  <small>Next · {next.n}</small>
                  <strong>{teasers[next.href] ?? next.label}</strong>
                </span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
                </svg>
              </a>
            )
          }

          <footer class="site-footer">
            <p>
              All computation runs in your browser — nothing is sent anywhere. CRCs use the textbook
              form (no initial value, reflection, or final XOR), so the numbers match the long-division
              table and circuit shown alongside them.
            </p>
          </footer>
        </div>
      </main>
    </div>

    <script>
      const rail = document.getElementById('rail');
      const toggle = rail?.querySelector<HTMLButtonElement>('.rail-toggle');
      toggle?.addEventListener('click', () => {
        const open = !rail!.hasAttribute('data-open');
        rail!.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
